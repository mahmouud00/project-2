{
	email {$ACME_EMAIL}
}

# Fingerprint devices (ZKTeco ADMS) that cannot speak HTTPS: /iclock only, on plain HTTP
http://{$DOMAIN} {
	handle /iclock/* {
		reverse_proxy api:8000
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

{$DOMAIN} {
	encode gzip
	request_body {
		max_size 500MB
	}
	reverse_proxy api:8000
}

# Programs older than 0.1.95 add «:8000» to any address: the same server, with HTTPS, on port 8000 too
{$DOMAIN}:8000 {
	encode gzip
	request_body {
		max_size 500MB
	}
	reverse_proxy api:8000
}
