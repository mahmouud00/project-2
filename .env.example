# ======== MYTech Solutions server settings ========
# offline = single company on a LAN server | online = cloud, many companies
APP_MODE=offline

# Three database roles (created by: python -m app.cli init-db --admin-url ...)
#  app    : used by the API, Row-Level Security enforced
#  system : BYPASSRLS, only login lookup / background jobs / vendor tools
#  owner  : owns the tables, runs migrations
DATABASE_URL=postgresql+psycopg://mytech_app:CHANGE_ME_APP@localhost:5432/mytech
DATABASE_SYSTEM_URL=postgresql+psycopg://mytech_system:CHANGE_ME_SYSTEM@localhost:5432/mytech
DATABASE_OWNER_URL=postgresql+psycopg://mytech_owner:CHANGE_ME_OWNER@localhost:5432/mytech

# Long random string (e.g. python -c "import secrets;print(secrets.token_urlsafe(64))")
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Offline licence file installed from MYTech; days of grace after expiry
LICENSE_FILE=license/license.json
LICENSE_GRACE_DAYS=14

# Uploaded images (models, materials)
MEDIA_DIR=media

# Daily backup
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_HOUR=2
# Folder of pg_dump/pg_restore if not on PATH, e.g. C:\Program Files\PostgreSQL\16\bin
PG_BIN_DIR=

# Network
DISCOVERY_ENABLED=true
DISCOVERY_UDP_PORT=47800
HTTP_PORT=8000
# Optional HTTPS (required in online mode, usually terminated by a reverse proxy)
SSL_CERTFILE=
SSL_KEYFILE=
# JSON list, e.g. ["https://app.example.com"]
# default: the desktop program (http://tauri.localhost, https://tauri.localhost, tauri://localhost)
# CORS_ORIGINS=["http://tauri.localhost","https://tauri.localhost","tauri://localhost"]

MIN_CLIENT_VERSION=0.1.0
