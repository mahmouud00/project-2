  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/leaflet": "1.9.12",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
