{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core features, notifications, opening map / WhatsApp links and the update downloads of the server, saving exported files to Downloads and showing them. No file system or shell access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.google.com/maps*"
        },
        {
          "url": "https://google.com/maps*"
        },
        {
          "url": "https://maps.google.com/*"
        },
        {
          "url": "https://maps.app.goo.gl/*"
        },
        {
          "url": "https://goo.gl/maps/*"
        },
        {
          "url": "https://www.openstreetmap.org/*"
        },
        {
          "url": "tel:*"
        },
        {
          "url": "https://wa.me/*"
        },
        {
          "url": "https://api.whatsapp.com/*"
        },
        {
          "url": "http://*/api/v1/system/clients/*"
        },
        {
          "url": "https://*/api/v1/system/clients/*"
        }
      ]
    },
    "notification:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
