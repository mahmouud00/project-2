<!-- WinSW service definition. The installer copies WinSW as service\MYTechServer.exe next to this file
     and runs "MYTechServer.exe install". mytech-service.exe starts the version in current.json. -->
<service>
  <id>MYTechServer</id>
  <name>MYTech Solutions Server</name>
  <description>MYTech Solutions API server (offline edition)</description>
  <executable>%BASE%\mytech-service.exe</executable>
  <workingdirectory>%BASE%\..\config</workingdirectory>
  <env name="MYTECH_ROOT" value="%BASE%\.."/>
  <env name="PYTHONUTF8" value="1"/>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>MYTechPostgreSQL</depend>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>%BASE%\..\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
